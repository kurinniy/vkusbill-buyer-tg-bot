{
  "name": "vkusvill-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot for group VkusVill orders via MCP.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "format": "biome check --write .",
    "lint": "biome check .",
    "start": "node dist/server.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "telegram:webhook": "node --import tsx src/cli/telegram-webhook.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.16.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.1",
    "prisma": "^5.16.1",
    "tsx": "^4.19.1",
    "typescript": "^5.7.2"
  }
}
